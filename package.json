    "express": "^4.21.0",
    "prisma": "^5.20.0",
    "socket.io": "^4.8.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2"
  }
}
